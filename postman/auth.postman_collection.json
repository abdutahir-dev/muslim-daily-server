                "bookmarks",
                "toggle"
              ]
            }
          }
        },
        {
          "name": "Get Favorites",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/favorites/{{username}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "favorites",
                "{{username}}"
              ]
            }
          }
        }
      ]
    }
  ]
}