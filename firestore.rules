rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidPrayerLog(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.date is string && data.date.size() <= 10 &&
             data.prayerName in ['fajr', 'dhuhr', 'asr', 'maghrib', 'isha'] &&
             data.status is bool;
    }

    function isValidFastingLog(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.date is string && data.date.size() <= 10 &&
             data.isFasting is bool;
    }

    function isValidJournalEntry(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.date is string && data.date.size() <= 10 &&
             data.notes is string && data.notes.size() <= 2000;
    }

    function isValidBookmark(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.itemType in ['ayah', 'hadith', 'dua'] &&
             data.itemId is string && data.itemId.size() <= 128;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // Prayer tracking subcollection
      match /prayerLogs/{logId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidPrayerLog(incoming(), userId);
        allow update: if isOwner(userId) && isValidPrayerLog(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Fasting tracking subcollection
      match /fastingLogs/{logId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidFastingLog(incoming(), userId);
        allow update: if isOwner(userId) && isValidFastingLog(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Spiritual journal subcollection
      match /journalEntries/{entryId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(entryId) && isValidJournalEntry(incoming(), userId);
        allow update: if isOwner(userId) && isValidJournalEntry(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(bookmarkId) && isValidBookmark(incoming(), userId);
        allow update: if isOwner(userId) && isValidBookmark(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
