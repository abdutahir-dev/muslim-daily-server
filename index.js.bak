// --- Admin Endpoints ---

app.post('/api/admin/seed', async (req, res) => {
  const { force = false, types = ['quran', 'translations', 'tafsirs', 'prayers'] } = req.body;
  try {
    console.log(`Manual seed triggered (force=${force}, types=${types.join(',')})`);

    const results = {};

    // 1. Basic Quran
    if (types.includes('quran')) {
      if (force) await seedBasicQuran(true);
      else seedBasicQuran(false);
      results.quran = 'seeded';
    }

    // 2. Translations
    if (types.includes('translations')) {
      if (force) await seedTranslationMetadata(true);
      else seedTranslationMetadata(false);
      results.translations = 'seeded';
    }

    // 3. Tafsirs
    if (types.includes('tafsirs')) {
      if (force) await seedTafsirMetadata(true);
      else seedTafsirMetadata(false);
      results.tafsirs = 'seeded';
    }

    // 4. Prayer Times
    if (types.includes('prayers')) {
      if (force) await seedPrayerTimes('Addis Ababa', 'Ethiopia', 2, new Date().getFullYear(), true);
      else seedPrayerTimes('Addis Ababa', 'Ethiopia', 2, new Date().getFullYear(), false);
      results.prayers = 'seeded';
    }

    res.json({
      success: true,
      message: force ? 'Selected data seeded successfully.' : 'Seeding started in background for selected types.',
      results
    });

  } catch (err) {
    console.error('Seed failed:', err);
    res.status(500).json({ error: 'Seeding failed', message: err.message });
  }
});

