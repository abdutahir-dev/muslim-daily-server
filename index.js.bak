import express from 'express';
import cors from 'cors';
import { open } from 'sqlite';
import sqlite3 from 'sqlite3';
import path from 'path';
import { fileURLToPath } from 'url';
import https from "https";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const app = express();
const PORT = process.env.PORT || 5003;

app.use(cors());
app.use(express.json());

// Database Connections
let quotesDb;
let deenbotDb;
let quranDb;
let prayersDb;

process.env.NODE_TLS_REJECT_UNAUTHORIZED = '0';

const agent = new https.Agent({
  rejectUnauthorized: false,
});

async function initDatabases() {
  quotesDb = await open({
    filename: path.join(__dirname, 'db', 'quotes.sqlite'),
    driver: sqlite3.Database
  });

  deenbotDb = await open({
    filename: path.join(__dirname, 'db', 'deenbot.sqlite'),
    driver: sqlite3.Database
  });

  quranDb = await open({
    filename: path.join(__dirname, 'db', 'quran.sqlite'),
    driver: sqlite3.Database
  });

  prayersDb = await open({
    filename: path.join(__dirname, 'db', 'prayers.sqlite'),
    driver: sqlite3.Database
  });

  // Ensure tables exist
  await prayersDb.exec(`
    CREATE TABLE IF NOT EXISTS prayer_timings (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      date TEXT,
      city TEXT,
      country TEXT,
      method INTEGER,
      fajr TEXT,
      sunrise TEXT,
      dhuhr TEXT,
      asr TEXT,
      maghrib TEXT,
      isha TEXT,
      UNIQUE(date, city, country, method)
    );
  `);
  await deenbotDb.exec(`
    CREATE TABLE IF NOT EXISTS users (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      username TEXT UNIQUE,
      email TEXT UNIQUE,
      password TEXT,
      role TEXT DEFAULT 'user',
      settings TEXT DEFAULT '{}',
      bookmarks TEXT DEFAULT '[]',
      favorites TEXT DEFAULT '[]'
    );
  `);

  // Migration: Add role column if it doesn't exist
  try {
    await deenbotDb.exec('ALTER TABLE users ADD COLUMN role TEXT DEFAULT "user"');
  } catch (e) {
    // Column might already exist
  }

  await deenbotDb.exec(`
    CREATE TABLE IF NOT EXISTS prayer_logs (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      username TEXT,
      date TEXT,
      prayer_name TEXT,
      status INTEGER DEFAULT 0,
      UNIQUE(username, date, prayer_name),
      FOREIGN KEY(username) REFERENCES users(username)
    );
  `);

  await quranDb.exec(`
    CREATE TABLE IF NOT EXISTS surahs (
      id INTEGER PRIMARY KEY,
      name_simple TEXT,
      name_arabic TEXT,
      verses_count INTEGER,
      revelation_place TEXT
    );
  `);

  // Migration: Add revelation_place column if it doesn't exist
  try {
    await quranDb.exec('ALTER TABLE surahs ADD COLUMN revelation_place TEXT');
  } catch (e) {
    // Column might already exist
  }

  await quranDb.exec(`
    CREATE TABLE IF NOT EXISTS ayahs (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        surah_number INTEGER,
        verse_number INTEGER,
        text_uthmani TEXT,
        verse_key TEXT UNIQUE,
        FOREIGN KEY(surah_number) REFERENCES surahs(id)
    );

    CREATE TABLE IF NOT EXISTS translations (
      id INTEGER PRIMARY KEY,
      name TEXT,
      language_name TEXT,
      author_name TEXT
    );

    CREATE TABLE IF NOT EXISTS tafsirs (
      id INTEGER PRIMARY KEY,
      name TEXT,
      language_name TEXT,
      author_name TEXT
    );

    CREATE TABLE IF NOT EXISTS ayah_translations (
        verse_key TEXT,
        translation_id INTEGER,
        text TEXT,
        PRIMARY KEY(verse_key, translation_id),
        FOREIGN KEY(verse_key) REFERENCES ayahs(verse_key),
        FOREIGN KEY(translation_id) REFERENCES translations(id)
    );

    CREATE TABLE IF NOT EXISTS ayah_tafsirs (
        verse_key TEXT,
        tafsir_id INTEGER,
        text TEXT,
        PRIMARY KEY(verse_key, tafsir_id),
        FOREIGN KEY(verse_key) REFERENCES ayahs(verse_key),
        FOREIGN KEY(tafsir_id) REFERENCES tafsirs(id)
    );

    CREATE INDEX IF NOT EXISTS idx_ayahs_surah ON ayahs(surah_number);
    CREATE INDEX IF NOT EXISTS idx_ayahs_key ON ayahs(verse_key);
  `);

  await seedQuranData();
  registerAdminRoutes();
  console.log('Databases initialized and Admin Routes Registered');
}

async function seedBasicQuran(force = false) {
  const count = await quranDb.get('SELECT COUNT(*) as count FROM ayahs');
  if (count.count === 0 || force) {
    console.log(force ? 'Force Seeding Basic Quran...' : 'Seeding Basic Quran...');
    try {
      const chaptersRes = await fetch('https://api.quran.com/api/v4/chapters', { agent });
      const { chapters } = await chaptersRes.json();

      await quranDb.exec('BEGIN TRANSACTION');
      if (force) {
        await quranDb.run('DELETE FROM ayahs');
        await quranDb.run('DELETE FROM surahs');
      }
      const insertSurah = await quranDb.prepare('INSERT OR REPLACE INTO surahs (id, name_simple, name_arabic, verses_count, revelation_place) VALUES (?, ?, ?, ?, ?)');
      const insertAyah = await quranDb.prepare('INSERT INTO ayahs (surah_number, verse_number, text_uthmani, verse_key) VALUES (?, ?, ?, ?)');

      for (const chapter of chapters) {
        await insertSurah.run(chapter.id, chapter.name_simple, chapter.name_arabic, chapter.verses_count, chapter.revelation_place);

        // Only seed ayahs if they are missing or forced
        const ayahCount = await quranDb.get('SELECT COUNT(*) as count FROM ayahs WHERE surah_number = ?', [chapter.id]);
        if (ayahCount.count === 0 || force) {
          const versesRes = await fetch(`https://api.quran.com/api/v4/quran/verses/uthmani?chapter_number=${chapter.id}`, { agent });
          const { verses } = await versesRes.json();
          for (const v of verses) {
            await insertAyah.run(chapter.id, parseInt(v.verse_key.split(':')[1]), v.text_uthmani, v.verse_key);
          }
        }
      }
      await insertSurah.finalize();
      await insertAyah.finalize();
      await quranDb.exec('COMMIT');
      console.log('Basic Quran text seeded.');
    } catch (err) {
      await quranDb.exec('ROLLBACK').catch(() => { });
      console.error('Failed to seed basic Quran text:', err);
    }
  }
}

async function seedTranslationMetadata(force = false) {
  const transCount = await quranDb.get('SELECT COUNT(*) as count FROM translations');
  if (transCount.count === 0 || force) {
    console.log('Fetching translations metadata...');
    const res = await fetch('https://api.quran.com/api/v4/resources/translations', { agent });
    const { translations } = await res.json();

    await quranDb.exec('BEGIN TRANSACTION');
    if (force) await quranDb.run('DELETE FROM translations');
    const ins = await quranDb.prepare('INSERT INTO translations (id, name, language_name, author_name) VALUES (?, ?, ?, ?)');
    for (const t of translations) {
      await ins.run(t.id, t.name, t.language_name, t.author_name);
    }
    await ins.finalize();
    await quranDb.exec('COMMIT');
    console.log(`Stored metadata for ${translations.length} translations.`);
    seedAllTranslations(translations.map(t => t.id));
  }
}

async function seedTafsirMetadata(force = false) {
  const tafsirCount = await quranDb.get('SELECT COUNT(*) as count FROM tafsirs');
  if (tafsirCount.count === 0 || force) {
    console.log('Fetching tafsirs metadata...');
    const res = await fetch('https://api.quran.com/api/v4/resources/tafsirs', { agent });
    const { tafsirs } = await res.json();

    await quranDb.exec('BEGIN TRANSACTION');
    if (force) await quranDb.run('DELETE FROM tafsirs');
    const ins = await quranDb.prepare('INSERT INTO tafsirs (id, name, language_name, author_name) VALUES (?, ?, ?, ?)');
    for (const t of tafsirs) {
      await ins.run(t.id, t.name, t.language_name, t.author_name);
    }
    await ins.finalize();
    await quranDb.exec('COMMIT');
    console.log(`Stored metadata for ${tafsirs.length} tafsirs.`);
    seedAllTafsirs(tafsirs.map(t => t.id));
  }
}

async function seedQuranData(force = false) {
  console.log('Checking Quran database...');
  await seedBasicQuran(force);
  await seedTranslationMetadata(force);
  await seedTafsirMetadata(force);
}

async function seedAllTranslations(ids) {
  console.log(`Background: Starting to seed ${ids.length} translations...`);

  // Fetch all verse keys once to map them by index
  let allAyahs;
  try {
    allAyahs = await quranDb.all('SELECT verse_key FROM ayahs ORDER BY id ASC');
  } catch (e) {
    console.error('Failed to fetch ayahs for translation mapping:', e.message);
    return;
  }

  for (const id of ids) {
    try {
      const exists = await quranDb.get('SELECT 1 FROM ayah_translations WHERE translation_id = ? LIMIT 1', [id]);
      if (exists) continue;

      console.log(`Seeding translation ID ${id}...`);
      const res = await fetch(`https://api.quran.com/api/v4/quran/translations/${id}`, { agent });

      if (!res.ok) {
        console.warn(`Translation ID ${id} fetch skipped: HTTP ${res.status}`);
        continue;
      }

      const contentType = res.headers.get("content-type");
      if (!contentType || !contentType.includes("application/json")) {
        console.warn(`Translation ID ${id} fetch skipped: Non-JSON response received`);
        continue;
      }

      const { translations } = await res.json();
      if (!translations || !Array.isArray(translations)) {
        console.warn(`Translation ID ${id} had no valid translations array.`);
        continue;
      }

      await quranDb.exec('BEGIN TRANSACTION');
      const ins = await quranDb.prepare('INSERT INTO ayah_translations (verse_key, translation_id, text) VALUES (?, ?, ?)');
      for (let i = 0; i < translations.length; i++) {
        const item = translations[i];
        // Use verse_key from API if available, otherwise fallback to ordered mapping
        const key = item.verse_key || allAyahs[i]?.verse_key;

        if (key) {
          await ins.run(key, id, item.text.replace(/<[^>]*>?/gm, ''));
        }
      }
      await ins.finalize();
      await quranDb.exec('COMMIT');

      // Small pause to be nice to the API
      await new Promise(r => setTimeout(r, 1000));
    } catch (e) {
      console.error(`Failed to seed translation ${id}:`, e.message);
      await quranDb.exec('ROLLBACK').catch(() => { });
    }
  }
  console.log('Background: All translations processed.');
}

async function seedAllTafsirs(ids) {
  console.log(`Background: Starting to seed ${ids.length} tafsirs...`);

  // Fetch all verse keys once to map them by index
  let allAyahs;
  try {
    allAyahs = await quranDb.all('SELECT verse_key FROM ayahs ORDER BY id ASC');
  } catch (e) {
    console.error('Failed to fetch ayahs for tafsir mapping:', e.message);
    return;
  }

  for (const id of ids) {
    try {
      const exists = await quranDb.get('SELECT 1 FROM ayah_tafsirs WHERE tafsir_id = ? LIMIT 1', [id]);
      if (exists) continue;

      console.log(`Seeding tafsir ID ${id}...`);
      const res = await fetch(`https://api.quran.com/api/v4/quran/tafsirs/${id}`, { agent });

      if (!res.ok) {
        console.warn(`Tafsir ID ${id} fetch skipped: HTTP ${res.status}`);
        continue;
      }

      const contentType = res.headers.get("content-type");
      if (!contentType || !contentType.includes("application/json")) {
        console.warn(`Tafsir ID ${id} fetch skipped: Non-JSON response received`);
        continue;
      }

      const data = await res.json();
      const tafsirs = data.tafsirs || data.translations; // API inconsistent sometimes

      if (!tafsirs || !Array.isArray(tafsirs)) {
        console.warn(`Tafsir ID ${id} had no valid tafsirs array.`);
        continue;
      }

      await quranDb.exec('BEGIN TRANSACTION');
      const ins = await quranDb.prepare('INSERT INTO ayah_tafsirs (verse_key, tafsir_id, text) VALUES (?, ?, ?)');
      for (let i = 0; i < tafsirs.length; i++) {
        const item = tafsirs[i];
        // Use verse_key from API if available, otherwise fallback to ordered mapping
        const key = item.verse_key || allAyahs[i]?.verse_key;

        if (key) {
          await ins.run(key, id, item.text);
        }
      }
      await ins.finalize();
      await quranDb.exec('COMMIT');

      // Small pause
      await new Promise(r => setTimeout(r, 1000));
    } catch (e) {
      console.error(`Failed to seed tafsir ${id}:`, e.message);
      await quranDb.exec('ROLLBACK').catch(() => { });
    }
  }
  console.log('Background: All tafsirs processed.');
}

async function seedPrayerTimes(city = 'Addis Ababa', country = 'Ethiopia', method = 2, year = new Date().getFullYear(), force = false) {
  try {
    const existing = await prayersDb.get(
      'SELECT COUNT(*) as count FROM prayer_timings WHERE city = ? AND country = ? AND method = ? AND date LIKE ?',
      [city, country, method, `${year}-%`]
    );

    if (existing.count > 0 && !force) {
      console.log(`Prayer times for ${city}, ${year} already seeded.`);
      return;
    }

    console.log(`Seeding prayer times for ${city}, ${year}...`);
    const res = await fetch(`https://api.aladhan.com/v1/calendarByCity/${year}?city=${city}&country=${country}&method=${method}`, { agent });
    const data = await res.json();

    if (data && data.data) {
      await prayersDb.exec('BEGIN TRANSACTION');
      if (force) {
        await prayersDb.run('DELETE FROM prayer_timings WHERE city = ? AND country = ? AND method = ? AND date LIKE ?', [city, country, method, `${year}-%`]);
      }

      const ins = await prayersDb.prepare(`
        INSERT INTO prayer_timings (date, city, country, method, fajr, sunrise, dhuhr, asr, maghrib, isha)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `);

      for (const month of Object.values(data.data)) {
        for (const day of month) {
          const date = day.date.gregorian.date; // YYYY-MM-DD
          const t = day.timings;
          await ins.run(
            date, city, country, method,
            t.Fajr.split(' ')[0], t.Sunrise.split(' ')[0], t.Dhuhr.split(' ')[0],
            t.Asr.split(' ')[0], t.Maghrib.split(' ')[0], t.Isha.split(' ')[0]
          );
        }
      }
      await ins.finalize();
      await prayersDb.exec('COMMIT');
      console.log(`Successfully seeded ${city} prayer times for ${year}.`);
    }
  } catch (err) {
    console.error('Failed to seed prayer times:', err.message);
    await prayersDb.exec('ROLLBACK').catch(() => { });
  }
}

// --- Resources ---

app.get('/api/resources/translations', async (req, res) => {
  try {
    const translations = await quranDb.all('SELECT id, name, language_name FROM translations ORDER BY name ASC');
    const trimmed = translations.map(t => ({
      ...t,
      name: t.name.trim(),
      language_name: t.language_name.trim()
    }));
    res.json(trimmed);
  } catch (err) {
    console.error('Failed to fetch translations metadata:', err);
    res.status(500).json({ error: 'Failed' });
  }
});

