app.post('/api/bookmarks/delete', async (req, res) => {
  const { username, id } = req.body;
  try {
    const user = await deenbotDb.get('SELECT bookmarks FROM users WHERE username = ?', [username]);
    let bookmarks = JSON.parse(user?.bookmarks || '[]');
    bookmarks = bookmarks.filter(b => b.id !== id);
    await deenbotDb.run('UPDATE users SET bookmarks = ? WHERE username = ?', [JSON.stringify(bookmarks), username]);
    res.json({ success: true, bookmarks });
  } catch (err) {
    res.status(500).json({ error: 'Failed to delete bookmark' });
  }
});

app.post('/api/favorites/delete', async (req, res) => {
  const { username, id } = req.body;
  try {
    const user = await deenbotDb.get('SELECT favorites FROM users WHERE username = ?', [username]);
    let favorites = JSON.parse(user?.favorites || '[]');
    favorites = favorites.filter(f => f.id !== id);
    await deenbotDb.run('UPDATE users SET favorites = ? WHERE username = ?', [JSON.stringify(favorites), username]);
    res.json({ success: true, favorites });
  } catch (err) {
    res.status(500).json({ error: 'Failed to delete favorite' });
  }
});

// --- Prayer Tracking ---

app.get('/api/prayers/times', async (req, res) => {
  const { city = 'Addis Ababa', country = 'Ethiopia', method = 2, date = new Date().toISOString().split('T')[0].split('-').reverse().join('-') } = req.query;
  console.log(city, country, method, date);
  try {
    // 1. Try Local DB first
    const local = await prayersDb.get(
      'SELECT fajr as Fajr, sunrise as Sunrise, dhuhr as Dhuhr, asr as Asr, maghrib as Maghrib, isha as Isha FROM prayer_timings WHERE city = ? AND country = ? AND method = ? AND date = ?',
      [city, country, parseInt(method), date]
    );

    if (local) {
      return res.json(local);
    }

    // 2. Fallback to API if not seeded and try to seed in background
    console.log(`Cache miss for ${city} on ${date}. Fetching from Aladhan API...`);
    const response = await fetch(`https://api.aladhan.com/v1/timingsByCity/${date}?city=${city}&country=${country}&method=${method}`, { agent });
    const data = await response.json();

    if (data && data.data && data.data.timings) {
      // Trigger background seeding for the whole year so we don't miss again
      seedPrayerTimes(city, country, method, new Date(date).getFullYear());
      res.json(data.data.timings);
    } else {
      console.warn('Aladhan API returned unexpected format:', data);
      res.status(502).json({ error: 'Invalid response from prayer times provider', details: data });
    }
  } catch (err) {
    console.error('Failed to fetch prayer times:', err.message);
    res.status(500).json({ error: 'Failed to fetch prayer times', message: err.message });
  }
});

app.get('/api/prayers/status/:username/:date', async (req, res) => {
  const { username, date } = req.params;
  try {
    const logs = await deenbotDb.all('SELECT prayer_name, status FROM prayer_logs WHERE username = ? AND date = ?', [username, date]);
    res.json(logs);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch prayer status' });
  }
});

app.post('/api/prayers/toggle', async (req, res) => {
  const { username, date, prayer_name } = req.body;
  try {
    const existing = await deenbotDb.get('SELECT status FROM prayer_logs WHERE username = ? AND date = ? AND prayer_name = ?', [username, date, prayer_name]);

    if (existing) {
      const newStatus = existing.status === 1 ? 0 : 1;
      await deenbotDb.run('UPDATE prayer_logs SET status = ? WHERE username = ? AND date = ? AND prayer_name = ?', [newStatus, username, date, prayer_name]);
      res.json({ success: true, status: newStatus });
    } else {
      await deenbotDb.run('INSERT INTO prayer_logs (username, date, prayer_name, status) VALUES (?, ?, ?, 1)', [username, date, prayer_name]);
      res.json({ success: true, status: 1 });
    }
  } catch (err) {
    res.status(500).json({ error: 'Failed to toggle prayer status' });
  }
});

app.get('/api/prayers/weekly/:username', async (req, res) => {
  const { username } = req.params;
  try {
    const weeklyData = await deenbotDb.all(`
      SELECT date, COUNT(*) as completed_count 
      FROM prayer_logs 
      WHERE username = ? AND status = 1 
      AND date >= date('now', '-7 days')
      GROUP BY date
      ORDER BY date DESC
    `, [username]);
    res.json(weeklyData);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch weekly stats' });
  }
});

app.get('/api/prayers/monthly/:username/:month', async (req, res) => {
  const { username, month } = req.params; // month format: YYYY-MM
  try {
    const monthlyData = await deenbotDb.all(`
      SELECT date, COUNT(*) as completed_count 
      FROM prayer_logs 
      WHERE username = ? AND status = 1 
      AND date LIKE ?
      GROUP BY date
      ORDER BY date ASC
    `, [username, `${month}-%`]);
    res.json(monthlyData);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch monthly stats' });
  }
});

