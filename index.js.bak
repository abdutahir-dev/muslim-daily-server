app.delete('/api/admin/users/:id', async (req, res) => {
  try {
    const { id } = req.params;
    const user = await deenbotDb.get('SELECT username FROM users WHERE id = ?', [id]);
    if (!user) return res.status(404).json({ error: 'User not found' });

    await deenbotDb.run('DELETE FROM prayer_logs WHERE username = ?', [user.username]);
    await deenbotDb.run('DELETE FROM users WHERE id = ?', [id]);

    res.json({ success: true, message: 'User and their logs deleted' });
  } catch (err) {
    res.status(500).json({ error: 'Failed to delete user' });
  }
});



// --- Generic CRUD Helper ---
function createCrudEndpoints(app, resourcePath, db, tableName, allowedFields, idField = 'id') {
  // GET All (Paginated)
  app.get(`/api/admin/${resourcePath}`, async (req, res) => {
    const { page = 1, limit = 10, sort = idField, order = 'DESC', search } = req.query;
    const offset = (page - 1) * limit;

    try {
      let query = `SELECT * FROM ${tableName}`;
      const params = [];

      // Simple generic search if requested
      if (search) {
        const searchField = allowedFields.find(f => !f.endsWith('_id') && !f.includes('number'));
        if (searchField) {
          query += ` WHERE ${searchField} LIKE ?`;
          params.push(`%${search}%`);
        }
      }

      query += ` ORDER BY ${sort} ${order} LIMIT ? OFFSET ?`;
      params.push(limit, offset);

      const items = await db.all(query, params);
      const countResult = await db.get(`SELECT COUNT(*) as count FROM ${tableName}`);

      res.json({
        data: items,
        total: countResult.count,
        page: parseInt(page),
        limit: parseInt(limit)
      });
    } catch (err) {
      console.error(`List ${resourcePath} failed:`, err);
      res.status(500).json({ error: 'Failed to fetch items' });
    }
  });

  // GET One
  app.get(`/api/admin/${resourcePath}/:id`, async (req, res) => {
    try {
      const item = await db.get(`SELECT * FROM ${tableName} WHERE ${idField} = ?`, [req.params.id]);
      if (!item) return res.status(404).json({ error: 'Item not found' });
      res.json(item);
    } catch (err) {
      res.status(500).json({ error: 'Failed to fetch item' });
    }
  });

  // CREATE
  app.post(`/api/admin/${resourcePath}`, async (req, res) => {
    const data = req.body;
    try {
      const fields = allowedFields.filter(f => data[f] !== undefined);
      if (fields.length === 0) return res.status(400).json({ error: 'No valid fields provided' });

      const placeholders = fields.map(() => '?').join(',');
      const values = fields.map(f => data[f]);

      await db.run(
        `INSERT INTO ${tableName} (${fields.join(',')}) VALUES (${placeholders})`,
        values
      );
      res.json({ success: true, message: 'Item created' });
    } catch (err) {
      console.error(`Create ${resourcePath} failed:`, err);
      res.status(500).json({ error: 'Failed to create item', details: err.message });
    }
  });

  // UPDATE
  app.put(`/api/admin/${resourcePath}/:id`, async (req, res) => {
    const data = req.body;
    try {
      const fields = allowedFields.filter(f => data[f] !== undefined);
      if (fields.length === 0) return res.status(400).json({ error: 'No valid fields provided' });

      const setClause = fields.map(f => `${f} = ?`).join(',');
      const values = [...fields.map(f => data[f]), req.params.id];

      await db.run(
        `UPDATE ${tableName} SET ${setClause} WHERE ${idField} = ?`,
        values
      );
      res.json({ success: true, message: 'Item updated' });
    } catch (err) {
      console.error(`Update ${resourcePath} failed:`, err);
      res.status(500).json({ error: 'Failed to update item', details: err.message });
    }
  });

  // DELETE
  app.delete(`/api/admin/${resourcePath}/:id`, async (req, res) => {
    try {
      if (tableName === 'users') {
        const user = await db.get('SELECT username FROM users WHERE id = ?', [req.params.id]);
        if (user) {
          await db.run('DELETE FROM prayer_logs WHERE username = ?', [user.username]);
        }
      }
      await db.run(`DELETE FROM ${tableName} WHERE ${idField} = ?`, [req.params.id]);
      res.json({ success: true, message: 'Item deleted' });
    } catch (err) {
      console.error(`Delete ${resourcePath} failed:`, err);
      res.status(500).json({ error: 'Failed to delete item' });
    }
  });
}

function registerAdminRoutes() {
  createCrudEndpoints(app, 'users', deenbotDb, 'users', ['username', 'email', 'password', 'role', 'settings', 'bookmarks', 'favorites']);
  createCrudEndpoints(app, 'surahs', quranDb, 'surahs', ['name_simple', 'name_arabic', 'verses_count', 'revelation_place']);
  createCrudEndpoints(app, 'ayahs', quranDb, 'ayahs', ['surah_number', 'verse_number', 'text_uthmani', 'verse_key']);
  createCrudEndpoints(app, 'translations', quranDb, 'translations', ['name', 'language_name', 'author_name']);
  createCrudEndpoints(app, 'tafsirs', quranDb, 'tafsirs', ['name', 'language_name', 'author_name']);
  createCrudEndpoints(app, 'prayer_timings', prayersDb, 'prayer_timings', ['date', 'city', 'country', 'method', 'fajr', 'sunrise', 'dhuhr', 'asr', 'maghrib', 'isha']);
  createCrudEndpoints(app, 'prayer_logs', deenbotDb, 'prayer_logs', ['username', 'date', 'prayer_name', 'status']);
}

initDatabases().then(() => {
  app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server running on http://0.0.0.0:${PORT}`);
  });
});
